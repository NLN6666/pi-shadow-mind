[Unit]
Description=Expose the Windows localhost proxy to Docker containers
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/socat TCP-LISTEN:7891,bind=172.17.0.1,reuseaddr,fork TCP:127.0.0.1:7890
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
